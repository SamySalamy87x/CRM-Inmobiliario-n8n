# ===================================
# CRM Inmobiliario n8n - Environment Configuration
# ===================================

# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/crm-inmobiliario
DB_HOST=localhost
DB_PORT=27017
DB_NAME=crm-inmobiliario
DB_USER=admin
DB_PASSWORD=password

# Email Configuration (Gmail)
GMAIL_EMAIL=your-email@gmail.com
GMAIL_PASSWORD=your-app-password
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET=your-client-secret

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your-service-sid

# Google Calendar Configuration
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
GOOGLE_CALENDAR_ID=your-calendar-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# n8n Configuration
N8N_WEBHOOK_URL=http://n8n-instance:5678/webhook
N8N_API_KEY=your-n8n-api-key
N8N_HOST=localhost
N8N_PORT=5678

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRE=7d

# Application Configuration
LOG_LEVEL=debug
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Lead Management
FOLLOWUP_DAYS=5
AUTO_SCHEDULE_ENABLED=true
SEND_CONFIRMATION_EMAIL=true

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_AUTO_FOLLOWUP=true
ENABLE_CALENDAR_SYNC=true

# Timezone
TIMEZONE=America/Mexico_City
